APP_NAME="The CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development - use SQLite
DB_CONNECTION=sqlite
# For production MySQL, uncomment below:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=crm
# DB_USERNAME=root
# DB_PASSWORD=

# Development: file sessions. Production: use database or file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production Security (uncomment for production)
# SESSION_SECURE_COOKIE=true
# SESSION_HTTP_ONLY=true
# AUTH_PASSWORD_TIMEOUT=10800

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

# REDIS - Available on production, not on local by default
# For production, set REDIS_CLIENT=predis if Redis is available
# REDIS_CLIENT=predis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# Local mail (Mailpit/Herd)
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="admin@crmlocal.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production SMTP (uncomment and configure):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.yourprovider.com
# MAIL_PORT=587
# MAIL_USERNAME=your-email@yourdomain.com
# MAIL_PASSWORD=your-password
# MAIL_ENCRYPTION=STARTTLS
# MAIL_FROM_ADDRESS="noreply@yourdomain.com"
# MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# API Keys - SET ON SERVER .env ONLY (never commit secrets)
SIGNABLE_API_SERVER=https://api.signable.co.uk/v1
SIGNABLE_API_KEY=
SIGNABLE_API_SECRET=
SIGNABLE_API_TIMEOUT=30
SIGNABLE_API_USER_ID=

# Signable webhook secret for verifying incoming webhooks
SIGNABLE_WEBHOOK_SECRET=

MYDIGITALACCOUNTS_BASE_URL=https://api.mydigitalaccounts.co.uk/v1
MYDIGITALACCOUNTS_CLIENT_ID=
MYDIGITALACCOUNTS_CLIENT_SECRET=
MYDIGITALACCOUNTS_API_KEY=
MYDIGITALACCOUNTS_REQUEST_TIMEOUT=30

# Internal Companies (comma-separated list of internal company names)
INTERNAL_COMPANIES="company 1,company 2,company 3"